/**
 * FOOD_LV3_CODES에서 무작위로 N개 코드 추출 (중복 없음)
 * @param {number} [n=3]
 * @returns {string[]}
 */
export function pickRandomCodes(n = 3) {
  const pool = FOOD_LV3_CODES.slice();
  const out = [];
  while (out.length < n && pool.length > 0) {
    const idx = Math.floor(Math.random() * pool.length);
    out.push(pool.splice(idx, 1)[0]);
  }
  return out;
}

/**
 * 특정 코드 3개 직접 지정 (테스트/고정용)
 * @param {[string, string, string]} codes
 * @returns {string[]}
 */
export function pickExactCodes([a, b, c] = []) {
  return [a, b, c].filter(Boolean);
}

